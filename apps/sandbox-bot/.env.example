# Copy to .env (gitignored) and fill in. Loaded with Node's --env-file.
# Bot token, from the Bot page of your application in the Discord developer portal.
DISCORD_TOKEN_DEV=
# Application ID, from the General Information page.
DISCORD_CLIENT_ID_DEV=
# The test guild commands are registered to (instant updates). Right-click the server > Copy Server ID.
DISCORD_GUILD_ID_DEV=
# Optional: where settings are stored. Defaults to .data/settings.json in this app.
# SETTINGS_FILE=
